{
  "name": "@nilscox/music-tools",
  "version": "1.2.0",
  "description": "Utilities for music stuff",
  "repository": "github:nilscox/music-tools",
  "files": [
    "lib",
    "src",
    "!**/*.spec.*"
  ],
  "type": "module",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test --experimental-test-isolation=none 'src/**/*.spec.ts'",
    "build": "rm -rf lib && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.15.0"
}
